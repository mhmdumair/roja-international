generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String      @unique
  description  String
  longDesc     String?
  price        Float
  comparePrice Float?
  unit         String
  stock        Int         @default(0)
  category     String
  images       String[]
  featured     Boolean     @default(false)
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  reviews      Review[]
}

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String      @unique
  buyerName       String
  buyerPhone      String
  buyerEmail      String?
  deliveryAddress String
  notes           String?
  items           OrderItem[]
  totalAmount     Float
  status          String      @default("pending")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  productId String  @db.ObjectId
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  buyerName  String
  buyerEmail String?
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SiteReview {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerName  String
  buyerEmail String?
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model StoreSettings {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  storeName      String   @default("Roja International")
  tagline        String?
  ownerName      String?
  ownerPhone     String?
  ownerEmail     String?
  whatsappNumber String?
  address        String?
  openingHours   String?
  facebook       String?
  instagram      String?
  tiktok         String?
  deliveryNote   String?
  minOrderNote   String?
  aboutText      String?
  heroImages     String[]
  updatedAt      DateTime @updatedAt
}
