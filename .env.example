# MongoDB Atlas
DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/roja-international?retryWrites=true&w=majority

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=store_products

# Resend email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=orders@yourdomain.com
STORE_OWNER_EMAIL=owner@gmail.com

# WhatsApp (country code + number, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=94771234567

# Admin — run: npx ts-node scripts/hashPassword.ts
ADMIN_PASSWORD_HASH=$2b$10$REPLACE_WITH_REAL_HASH
# run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=replace_with_64_char_random_string

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
